[Unit]
Description=Z890 LCD Unleashed - ROG MAXIMUS Z890 EXTREME LCD service
Documentation=https://github.com/ssjrocks/z890-lcd-unleashed
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.ssjrocks.Z890Lcd
ExecStart=@BINDIR@/z890-lcd-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
